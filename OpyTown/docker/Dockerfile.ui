FROM node:20-alpine

WORKDIR /app

# Install wget, curl, and ping (iputils)
RUN apk add --no-cache wget curl iputils

# Reduce npm log noise so build doesn't appear stuck
ENV NPM_CONFIG_LOGLEVEL=warn
ENV NPM_CONFIG_FETCH_TIMEOUT=120000

# Copy only package files first for better layer caching
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies from lockfile (faster and deterministic; no host node_modules)
RUN npm ci

# Copy application source (node_modules excluded via .dockerignore)
COPY frontend/ .

# Build the app
RUN npm run build
RUN npm cache clean --force

# Expose port 3000
EXPOSE 3000

# Copy the script to build and serve the UI
COPY docker/ui-build-and-serve.sh ./ui-build-and-serve.sh
# Start the application
CMD ["sh", "./ui-build-and-serve.sh"]